# 100Solutionz Lead Intelligence Platform - Environment Variables
# Copy this to .env and fill in actual values. Never commit .env!

# Apify Configuration
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=your_actor_id_here

# AI Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.7

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SENDER_NAME=100Solutionz
SENDER_EMAIL=your_email@gmail.com

# Database Configuration
DATABASE_URL=sqlite:///data/leads.db

# Application Settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DRY_RUN=true

# Pipeline Settings
MAX_CONCURRENT_WEBSITES=5
MAX_PAGES_PER_WEBSITE=10
REQUEST_TIMEOUT=30
MAX_DISCOVERY_RESULTS=100

# Compliance
BUSINESS_NAME=100Solutionz
BUSINESS_ADDRESS=Your Business Address Here
UNSUBSCRIBE_ENABLED=true
